# Never send these into the image build context.
**/node_modules
**/.venv
**/__pycache__
**/.pytest_cache
**/.ruff_cache
.git
.gitignore

# --- Secrets: NEVER bake into an image. Cloud Run gets them from Secret
# --- Manager / service env vars (see DEPLOY_GCP.md).
.env
**/.env
.env.*
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/service-account*.json

# Local build output (Docker rebuilds the SPA in stage 1)
frontend/dist
frontend/build

# DuckDB: keep the seed DBs, drop the local working copies / auth db / WAL
!backend/data/*_src.duckdb
backend/data/*.duckdb.wal
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal

# Docs / scratch
README.md
DEPLOY_GCP.md
**/*.log
**/*_output.txt
**/_*.cjs
**/_*.js
**/_*.png