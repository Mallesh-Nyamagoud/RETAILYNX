# =============================================================================
# RETAILYNX backend - environment variables (NAMES ONLY, no real secrets)
# =============================================================================
# Copy this file to `backend/.env` for local development:
#     cp backend/.env.example backend/.env
# Never commit the filled-in `.env` - it is in .gitignore.
#
# On Cloud Run these are supplied as service environment variables and/or
# Secret Manager references instead of a file. See DEPLOY_GCP.md.
# =============================================================================

# --- Required (the app refuses to start without these) ----------------------
# Long random string used to SIGN the session cookie. Generate one with:
#     openssl rand -hex 32     (or: python -c "import secrets;print(secrets.token_hex(32))")
# Changing it invalidates every existing login.
SESSION_SECRET_KEY=

# The first ADMIN account, created on startup ONLY if no admin exists yet.
# To rotate the password later, use the Admin "User Access" screen.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Required in production (ENVIRONMENT=production), optional in dev -------
# User database. Cloud Run's disk is ephemeral, so production MUST point this
# at an external Postgres, otherwise every account is lost on each restart.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Local development fallback (used when unset): SQLite under DATA_DIR.
DATABASE_URL=

# Where the analytics data lives: the committed `*_src.duckdb` seed files
# and/or Parquet files. Local default: backend/data
DATA_DIR=

# --- Optional ---------------------------------------------------------------
# production turns on Secure cookies + the strict startup checks. Default: development
ENVIRONMENT=

# Comma-separated browser origins allowed to call /api. Same-origin by default.
CORS_ORIGINS=

# DuckDB resource caps (the Cloud Run service has 2 GiB / 1 vCPU)
DUCKDB_MEMORY_LIMIT=
DUCKDB_THREADS=

# Google Identity Services (optional; leave blank to use username/password only)
GOOGLE_WORKSPACE_DOMAIN=adonisgroup.in

# Failed-login throttle (defaults: 5 attempts, 15 minute lockout)
MAX_LOGIN_ATTEMPTS=
LOGIN_LOCKOUT_SECONDS=
LOGIN_ATTEMPT_WINDOW_SECONDS=

# bcrypt cost for new password hashes (default 12; tests use 4 for speed)
BCRYPT_ROUNDS=